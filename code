    <script>
        // Sticker Data
        const stickers = [
            {
                id: 1,
                name: "Kawaii Cat",
                category: "animals",
                price: 2.99,
                originalPrice: 3.99,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/1beb14f81-70bb-4304-ade3-c784ac494116.png",
                description: "Adorable pink & blue kitty",
                rating: 4.9,
                reviews: 128,
                tag: "Best Seller"
            },
            {
                id: 2,
                name: "Sakura Blossom",
                category: "nature",
                price: 2.49,
                originalPrice: 3.49,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/104f07b28-558b-4194-99fe-ad608863eba0.png",
                description: "Beautiful pink cherry blossoms",
                rating: 4.8,
                reviews: 95,
                tag: "New"
            },
            {
                id: 3,
                name: "Happy Rainbow",
                category: "celestial",
                price: 1.99,
                originalPrice: 2.99,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/19678c722-461e-4eb5-b478-484f2eae67a7.png",
                description: "Colorful rainbow with cute clouds",
                rating: 4.9,
                reviews: 203,
                tag: "Popular"
            },
            {
                id: 4,
                name: "Coffee Love",
                category: "food",
                price: 2.49,
                originalPrice: 3.49,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/1c1e06d8c-11df-4e63-b84c-670e6f6fba60.png",
                description: "Latte art heart in pink cup",
                rating: 4.7,
                reviews: 87,
                tag: null
            },
            {
                id: 5,
                name: "Moon & Star",
                category: "celestial",
                price: 2.99,
                originalPrice: 3.99,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/17f2ac092-5a43-47ef-8b61-d2314f278e70.png",
                description: "Kawaii moon and purple star",
                rating: 5.0,
                reviews: 156,
                tag: "Top Rated"
            },
            {
                id: 6,
                name: "Heart Sparkle",
                category: "love",
                price: 1.99,
                originalPrice: 2.99,
                image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/1d68c99ce-5490-4939-ad6f-7114fe3e9d38.png",
                description: "Pink hearts with gold stars",
                rating: 4.8,
                reviews: 174,
                tag: "Bundle"
            }
        ];

        let cart = [];
        let currentCategory = 'all';
        let currentSort = 'featured';

        // Render Stickers
        function renderStickers() {
            const grid = document.getElementById('stickerGrid');
            const noResults = document.getElementById('noResults');
            const stickerCount = document.getElementById('stickerCount');

            let filtered = currentCategory === 'all' ? [...stickers] : stickers.filter(s => s.category === currentCategory);

            // Search filter
            const searchTerm = document.getElementById('searchInput')?.value?.toLowerCase() || '';
            if (searchTerm) {
                filtered = filtered.filter(s =>
                    s.name.toLowerCase().includes(searchTerm) ||
                    s.description.toLowerCase().includes(searchTerm) ||
                    s.category.toLowerCase().includes(searchTerm)
                );
            }

            // Sort
            switch (currentSort) {
                case 'price-low': filtered.sort((a, b) => a.price - b.price); break;
                case 'price-high': filtered.sort((a, b) => b.price - a.price); break;
                case 'name': filtered.sort((a, b) => a.name.localeCompare(b.name)); break;
            }

            stickerCount.textContent = `Showing ${filtered.length} sticker${filtered.length !== 1 ? 's' : ''}`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                noResults.classList.remove('hidden');
                return;
            }

            noResults.classList.add('hidden');

            grid.innerHTML = filtered.map((sticker, index) => `
                <div class="sticker-card bg-white rounded-2xl overflow-hidden border border-pink-100 shadow-sm" style="animation: slideUp 0.5s ease-out ${index * 0.1}s both;">
                    <div class="relative bg-gradient-to-b from-pink-50/50 to-white p-6">
                        ${sticker.tag ? `<span class="absolute top-3 left-3 px-2.5 py-1 bg-brand-500 text-white text-xs font-bold rounded-full">${sticker.tag}</span>` : ''}
                        <button onclick="addToWishlist(${sticker.id})" class="absolute top-3 right-3 w-8 h-8 bg-white/80 rounded-full flex items-center justify-center hover:bg-white transition-colors shadow-sm">
                            <span class="text-sm">🤍</span>
                        </button>
                        <img src="${sticker.image}" alt="${sticker.name}" class="sticker-img w-full max-w-[200px] mx-auto block sticker-shadow">
                    </div>
                    <div class="p-5">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs font-medium text-brand-400 bg-brand-50 px-2 py-0.5 rounded-full capitalize">${sticker.category}</span>
                            <div class="flex items-center gap-1">
                                <span class="text-xs text-yellow-400">⭐</span>
                                <span class="text-xs font-semibold text-gray-500">${sticker.rating}</span>
                                <span class="text-xs text-gray-300">(${sticker.reviews})</span>
                            </div>
                        </div>
                        <h3 class="font-bold text-gray-800 text-lg mt-2">${sticker.name}</h3>
                        <p class="text-sm text-gray-400 mt-1">${sticker.description}</p>
                        <div class="flex items-center justify-between mt-4">
                            <div class="flex items-center gap-2">
                                <span class="text-xl font-extrabold text-brand-500">$${sticker.price.toFixed(2)}</span>
                                <span class="text-sm text-gray-300 line-through">$${sticker.originalPrice.toFixed(2)}</span>
                            </div>
                            <button onclick="addStickerToCart(${sticker.id})" class="p-2.5 bg-brand-500 text-white rounded-xl hover:bg-brand-600 transition-colors shadow-md hover:shadow-lg active:scale-95">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Filter Category
        function filterCategory(category) {
            currentCategory = category;
            document.querySelectorAll('.category-pill').forEach(pill => {
                pill.classList.remove('active');
                if (pill.textContent.toLowerCase().includes(category === 'all' ? 'all' : category)) {
                    pill.classList.add('active');
                }
            });
            renderStickers();
        }

        // Sort Stickers
        function sortStickers(value) {
            currentSort = value;
            renderStickers();
        }

        // Filter Stickers (search)
        function filterStickers() {
            renderStickers();
        }

        // Add to Cart
        function addStickerToCart(stickerId) {
            let sticker;
            if (stickerId === 'special') {
                sticker = { id: 'special', name: 'Nara Deer Collection', price: 3.99, image: "https://image.qwenlm.ai/public_source/f3af0349-283f-462b-8e6e-cba110aa5349/1beb14f81-70bb-4304-ade3-c784ac494116.png", quantity: 1 };
            } else {
                sticker = stickers.find(s => s.id === stickerId);
            }

            const existingItem = cart.find(item => item.id === sticker.id);
            if (existingItem) {
                existingItem.quantity++;
            } else {
                cart.push({ ...sticker, quantity: 1 });
            }

            updateCartUI();
            showToast(`${sticker.name} added to cart! 🎉`);
        }

        // Remove from Cart
        function removeFromCart(stickerId) {
            cart = cart.filter(item => item.id !== stickerId);
            updateCartUI();
        }

        // Update Quantity
        function updateQuantity(stickerId, delta) {
            const item = cart.find(i => i.id === stickerId);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(stickerId);
                    return;
                }
            }
            updateCartUI();
        }

        // Clear Cart
        function clearCart() {
            cart = [];
            updateCartUI();
            showToast('Cart cleared! 🗑️');
        }

        // Update Cart UI
        function updateCartUI() {
            const cartCount = document.getElementById('cartCount');
            const cartItems = document.getElementById('cartItems');
            const cartFooter = document.getElementById('cartFooter');
            const cartEmpty = document.getElementById('cartEmpty');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            // Badge
            if (totalItems > 0) {
                cartCount.classList.remove('hidden');
                cartCount.classList.add('flex');
                cartCount.textContent = totalItems;
                // Re-trigger animation
                cartCount.classList.remove('cart-badge');
                void cartCount.offsetWidth;
                cartCount.classList.add('cart-badge');
            } else {
                cartCount.classList.add('hidden');
                cartCount.classList.remove('flex');
            }

            // Cart items
            if (cart.length === 0) {
                cartItems.innerHTML = '';
                cartFooter.classList.add('hidden');
                cartEmpty.classList.remove('hidden');
            } else {
                cartEmpty.classList.add('hidden');
                cartFooter.classList.remove('hidden');

                cartItems.innerHTML = cart.map(item => `
                    <div class="flex items-center gap-4 py-4 border-b border-pink-50 pop-in">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-contain rounded-xl bg-pink-50 p-1">
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-gray-800 text-sm truncate">${item.name}</h4>
                            <p class="text-brand-500 font-semibold text-sm">$${item.price.toFixed(2)}</p>
                            <div class="flex items-center gap-2 mt-2">
                                <button onclick="updateQuantity('${item.id}', -1)" class="quantity-btn w-6 h-6 rounded-full bg-pink-100 text-gray-600 flex items-center justify-center text-xs font-bold hover:bg-pink-200">−</button>
                                <span class="text-sm font-bold text-gray-700 w-6 text-center">${item.quantity}</span>
                                <button onclick="updateQuantity('${item.id}', 1)" class="quantity-btn w-6 h-6 rounded-full bg-pink-100 text-gray-600 flex items-center justify-center text-xs font-bold hover:bg-pink-200">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart('${item.id}')" class="p-1.5 rounded-full hover:bg-red-50 text-gray-300 hover:text-red-400 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                `).join('');

                const shipping = subtotal >= 25 ? 0 : 4.99;
                document.getElementById('cartSubtotal').textContent = `$${subtotal.toFixed(2)}`;
                document.getElementById('cartShipping').textContent = shipping === 0 ? 'FREE' : `$${shipping.toFixed(2)}`;
                document.getElementById('cartShipping').className = shipping === 0 ? 'font-bold text-green-500 text-sm' : 'font-bold text-gray-700 text-sm';
                document.getElementById('cartTotal').textContent = `$${(subtotal + shipping).toFixed(2)}`;
            }
        }

        // Toggle Cart
        function toggleCart() {
            const overlay = document.getElementById('cartOverlay');
            const drawer = document.getElementById('cartDrawer');

            if (overlay.classList.contains('hidden')) {
                overlay.classList.remove('hidden');
                requestAnimationFrame(() => {
                    overlay.style.opacity = '1';
                    drawer.style.transform = 'translateX(0)';
                });
                document.body.style.overflow = 'hidden';
            } else {
                overlay.style.opacity = '0';
                drawer.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    overlay.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 300);
            }
        }

        // Toggle Search
        function toggleSearch() {
            const searchBar = document.getElementById('searchBar');
            searchBar.classList.toggle('hidden');
            if (!searchBar.classList.contains('hidden')) {
                document.getElementById('searchInput').focus();
            }
        }

        // Wishlist
        function addToWishlist(stickerId) {
            showToast('Added to wishlist! 💕');
        }

        // Toast Notification
        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'added-toast bg-gray-900 text-white px-5 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2';
            toast.textContent = message;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        // Subscribe
        function subscribe() {
            const email = document.getElementById('emailInput').value;
            const msg = document.getElementById('subscribeMsg');
            const btn = document.getElementById('subscribeBtn');

            if (email && email.includes('@')) {
                btn.textContent = 'Subscribed! ✅';
                btn.disabled = true;
                msg.classList.remove('hidden');
            } else {
                showToast('Please enter a valid email 📧');
            }
        }

        // Checkout
        function checkout() {
            showToast('Redirecting to checkout... 💳');
            setTimeout(() => {
                alert('Thank you for your order! 🎉\n\nThis is a demo - no real payment processed.\n\nTotal: ' + document.getElementById('cartTotal').textContent);
                cart = [];
                updateCartUI();
                toggleCart();
            }, 500);
        }

        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        });

        // Initialize
        renderStickers();
    </script>
